[Unit]
Description=NAOMOX — netbooter NetDIMM (API + interface web)
Documentation=https://github.com/metisnc/NAOMOX
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=naomox
Group=naomox
Environment=PYTHONUNBUFFERED=1
Environment=NAOMOX_CONFIG=/etc/naomox/config.yaml
ExecStart=/opt/naomox/venv/bin/naomox serve
Restart=on-failure
RestartSec=3
# Journaux : stdout/stderr → journald (`journalctl -u naomox -f`).

# Port 80 sans root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Durcissement.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/naomox
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
UMask=0027

[Install]
WantedBy=multi-user.target
