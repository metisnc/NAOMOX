<?xml version="1.0" standalone="no"?>
<!-- Annonce Bonjour / mDNS de l'interface NAOMOX (http://<nom-du-ct>.local). -->
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name>NAOMOX</name>
  <service>
    <type>_http._tcp</type>
    <port>80</port>
    <txt-record>path=/</txt-record>
  </service>
</service-group>
